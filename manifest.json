{
  "manifest_version": 3,
  "name": "Lighthouse Handoff",
  "version": "0.2.0",
  "description": "Convert Google PageSpeed Insights audits into clean, coding-agent-ready Markdown reports.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lighthouse Handoff",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "report.html", "report.js", "report.css",
        "utils/report-parser.js",
        "report-builder.js",
        "src/ai/types.js",
        "src/ai/engine.js",
        "src/ai/providers/mock.js",
        "src/ai/providers/ollama.js",
        "src/ai/providers/openai.js",
        "src/ai/prompts/cursor.js",
        "src/ai/prompts/github.js",
        "src/ai/prompts/client.js",
        "src/lighthouse/normalizer.js",
        "src/lighthouse/scoring.js",
        "src/lighthouse/parser.js",
        "src/output/markdown.js",
        "src/output/exporters.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
